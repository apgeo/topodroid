<?xml version="1.0" encoding="utf-8"?>
<!-- Debug-build override of the clone's res/xml/network_security_config.xml.
     Keeps upstream's domain entry and also allows cleartext HTTP to the emulator's
     alias for the host (10.0.2.2) and to loopback, so a debug APK can reach a local
     development server. Release builds use the upstream file unchanged. -->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">marcocorvi.altervista.org</domain>
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>

    <base-config cleartextTrafficPermitted="false" >
    </base-config>
</network-security-config>
